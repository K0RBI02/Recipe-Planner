{
	"schemaVersion": 1,
	"id": "recipeplanner",
	"version": "${version}",
	"name": "Recipe Planner",
	"description": "Plan what you want to craft and see which ingredients you still need. Right-click recipes in the recipe book to add them; a small list next to your inventory shows what is missing, counting your inventory and the open chest.",
	"authors": [
		"KORBI8674"
	],
	"contact": {
		"homepage": "https://www.curseforge.com/minecraft/mc-mods/recipe-planner",
		"sources": "https://github.com/K0RBI02/Recipe-Planner",
		"issues": "https://github.com/K0RBI02/Recipe-Planner/issues"
	},
	"license": "MIT",
	"icon": "assets/recipeplanner/icon.png",
	"environment": "client",
	"entrypoints": {
		"client": [
			"de.korbi8674.recipeplanner.client.RecipePlannerClient"
		]
	},
	"mixins": [
		{
			"config": "recipeplanner.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.19.5",
		"minecraft": "~26.3",
		"java": ">=25",
		"fabric-api": "*"
	}
}
